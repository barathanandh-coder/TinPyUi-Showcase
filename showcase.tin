                        Link(text = "Explore Features", href = "#features", onClick = "window.location.href='#features'", class_ = "bg-tertiary text-on-tertiary-fixed px-8 py-4 font-bold rounded-lg shadow-[0_0_20px_rgba(231,195,101,0.4)] hover:scale-105 transition-all inline-block cursor-pointer")
                        Link(text = "Get Started", href = "https://www.npmjs.com/package/tinpyui?activeTab=versions", class_ = "border border-primary text-primary px-8 py-4 font-bold rounded-lg hover:bg-primary/10 transition-all inline-block cursor-pointer")
                Container():
