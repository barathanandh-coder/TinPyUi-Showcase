                        Button(text = "Learn More", onClick = "window.open('https://github.com/barathanandh-coder/TinUi/blob/main/README.md', '_blank')", class_ = "w-full py-3 bg-surface-container-highest text-primary font-bold rounded group-hover:bg-primary group-hover:text-on-primary transition-colors")

